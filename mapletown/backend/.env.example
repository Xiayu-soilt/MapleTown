DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

DATABASE_URL=sqlite:///./mapletown.db

JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

TICK_SECONDS=3
SIM_MINUTES_PER_TICK=10

LLM_CONCURRENCY=5
LLM_TIMEOUT=90
DAILY_TOKEN_BUDGET=3000000

# 记忆三因子检索（score = α·recency + β·importance + γ·relevance）
EMBEDDING_PROVIDER=auto
CHROMA_DIR=./chroma_data
RETRIEVAL_ALPHA=1.0
RETRIEVAL_BETA=1.0
RETRIEVAL_GAMMA=1.0
RETRIEVAL_CANDIDATES=32
RECENCY_DECAY_PER_HOUR=0.995

# M3 日程规划
PLAN_PER_TICK=3

# M3 对话引擎
DIALOGUE_MAX_TURNS=8
DIALOGUE_PER_TICK=2

# M3 反思引擎
REFLECTION_THRESHOLD=120
REFLECTION_MIN_MEMORIES=20
REFLECTION_PER_TICK=2

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
